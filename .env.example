# Public (exposed to the browser); must be prefixed with NEXT_PUBLIC_

# Canonical origin. Must match the host the site is actually served from:
# canonical URLs, og:url, hreflang and the sitemap all derive from it.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ViraStack"


# Server-only (never exposed to the browser)
# NODE_ENV is set automatically by Next.js; no need to define it here.

# Upstash Redis (Vercel Marketplace → KV_REST_API_*). Required for /api/telemetry.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
