{
  "name": "virastack-com",
  "version": "1.0.0",
  "private": true,
  "description": "Official website and docs for the ViraStack ecosystem",
  "license": "MIT",
  "virastack": {
    "template": "nextjs",
    "version": "1.0.4",
    "i18n": true,
    "url": "https://virastack.com"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "content:pull": "node scripts/pull-academy-content.mjs",
    "content:llms": "node scripts/build-academy-llms.mjs",
    "vendor:maplibre": "node scripts/vendor-maplibre-worker.mjs",
    "prebuild": "pnpm content:pull && pnpm content:llms && pnpm vendor:maplibre",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "clean": "rimraf .next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache && prettier --write .",
    "lint:ci": "eslint . --max-warnings=0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "pnpm vendor:maplibre"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix --cache",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@upstash/redis": "^1.38.1",
    "@virastack/address": "1.0.0",
    "@virastack/mask": "2.1.0",
    "@virastack/mask-v1": "npm:@virastack/mask@1.1.0",
    "@virastack/password": "1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.25.0",
    "maplibre-gl": "^6.16.0",
    "motion": "^12.43.0",
    "next": "16.4.3",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.82.0",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/bundle-analyzer": "^16.2.12",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "knip": "^6.28.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ]
}
